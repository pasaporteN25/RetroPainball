const PALETTES := {
	GameState.KERNEL_PANIC: KERNEL_PALETTE,
	GameState.NAUTILUS: NAUTILUS_PALETTE,
	GameState.DRACULA: DRACULA_PALETTE,
	GameState.ALICIA: ALICIA_PALETTE,
}
const PIXELS := {
	GameState.KERNEL_PANIC: KERNEL_PIXELS,
	GameState.NAUTILUS: NAUTILUS_PIXELS,
	GameState.DRACULA: DRACULA_PIXELS,
	GameState.ALICIA: ALICIA_PIXELS,
}

static var _cached_layers: Dictionary[String, Array] = {}


## Dibuja el póster dentro de rect. Llamalo desde _draw(); time está en segundos.
static func draw(canvas: CanvasItem, table_id: String, rect: Rect2, time: float = 0.0) -> void:
	if not PALETTES.has(table_id):
		canvas.draw_rect(rect, FALLBACK)
		return
	var palette: Array[Color] = PALETTES[table_id]
	canvas.draw_rect(rect, palette[0])
	var layers := _layers_for(table_id)
	for shade in range(1, palette.size()):
		var runs: Array[Rect2i] = layers[shade]
		for run in runs:
			cell(canvas, rect, run.position.x, run.position.y, palette[shade], run.size.x, run.size.y)
	_draw_detail(canvas, table_id, rect, time, palette)


## Pinta w × h celdas de la grilla, a partir de (x, y).
static func cell(canvas: CanvasItem, rect: Rect2, x: int, y: int, color: Color, w: int = 1, h: int = 1) -> void:
	var size := rect.size / Vector2(GRID)
	canvas.draw_rect(Rect2(rect.position + Vector2(x, y) * size, Vector2(w, h) * size), color, true)


static func _layers_for(table_id: String) -> Array:
	if not _cached_layers.has(table_id):
		_cached_layers[table_id] = _compile_layers(PIXELS[table_id], PALETTES[table_id].size())
	return _cached_layers[table_id]


## Agrupá celdas del mismo color en rectángulos una sola vez, al primer dibujo.
static func _compile_layers(pixels: String, color_count: int) -> Array[Array]:
	var layers: Array[Array] = []
	for shade in color_count:
		var layer: Array[Rect2i] = []
		layers.append(layer)
	var rows := pixels.strip_edges().split("\n")
	var previous: Dictionary[Vector3i, int] = {}
	for y in rows.size():
		var row := rows[y]
		var current: Dictionary[Vector3i, int] = {}
		var start := 0
		while start < row.length():
			var digit := row.unicode_at(start)
			var end := start + 1
			while end < row.length() and row.unicode_at(end) == digit:
				end += 1
			var shade := digit - 48
			if shade > 0:
				var run := Vector3i(start, end - start, shade)
				var layer: Array[Rect2i] = layers[shade]
				var index: int = previous.get(run, layer.size())
				if index == layer.size():
					layer.append(Rect2i(start, y, run.y, 1))
				else:
					var merged := layer[index]
					merged.size.y += 1
					layer[index] = merged
				current[run] = index
			start = end
		previous = current
	return layers


static func _draw_detail(canvas: CanvasItem, table_id: String, rect: Rect2, time: float, palette: Array[Color]) -> void:
	match table_id:
		GameState.KERNEL_PANIC:
			# El cursor queda encendido la mayor parte del ciclo.
			if fposmod(time, 2.4) < 1.6:
				cell(canvas, rect, 39, 50, palette[4], 3)
		GameState.NAUTILUS:
			# Una burbuja sube en saltitos detrás del submarino.
			var rise := floori(fposmod(time, 3.0) * 2.0)
			cell(canvas, rect, 9, 22 - rise, palette[4])
		GameState.DRACULA:
			if fposmod(time, 3.2) < 1.1:
				cell(canvas, rect, 13, 4, palette[6])
		GameState.ALICIA:
			if fposmod(time, 3.6) < 1.2:
				cell(canvas, rect, 39, 51, palette[2])
