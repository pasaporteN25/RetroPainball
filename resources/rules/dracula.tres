[gd_resource type="Resource" script_class="TableRules" format=3]

[ext_resource type="Script" path="res://scripts/resources/rule_stage.gd" id="1_w1gbb"]
[ext_resource type="Script" path="res://scripts/resources/table_rules.gd" id="2_1pogc"]

[sub_resource type="Resource" id="Resource_21di7"]
script = ExtResource("1_w1gbb")
award = 500
message = "CARFAX {stage}/{total}"

[sub_resource type="Resource" id="Resource_afcbj"]
script = ExtResource("1_w1gbb")
award = 1000
message = "CARFAX {stage}/{total}"

[sub_resource type="Resource" id="Resource_hjkaq"]
script = ExtResource("1_w1gbb")
award = 1500
raise_multiplier = true
message = "¡CARFAX!  BONUS X{bonus}"

[sub_resource type="Resource" id="Resource_n78ou"]
script = ExtResource("1_w1gbb")
award = 5000
raise_multiplier = true
message = "¡JACKPOT!  {depth} m  BONUS X{bonus}"

[resource]
script = ExtResource("2_1pogc")
table_id = "dracula"
kraken_jackpot = SubResource("Resource_n78ou")
