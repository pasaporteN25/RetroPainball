[gd_resource type="Resource" script_class="TableRules" format=3]

[ext_resource type="Script" path="res://scripts/resources/rule_stage.gd" id="1_stage"]
[ext_resource type="Script" path="res://scripts/resources/table_rules.gd" id="2_rules"]

[sub_resource type="Resource" id="Resource_cards"]
